# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Neon pooled PostgreSQL connection string. Required in deployed environments.
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# Single-owner admin authentication. Generate the password hash with:
# python scripts/create_password_hash.py
ADMIN_USERNAME=hriday
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-hash
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=480
ADMIN_RATE_LIMIT_MAX_REQUESTS=5
ADMIN_RATE_LIMIT_WINDOW_SECONDS=900

# SMTP delivery configuration for contact form submissions.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
TO_EMAIL=hridaysaluja2@gmail.com

# Recommended for Render: Resend HTTP email API (works without SMTP ports).
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Contact abuse protection.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=900
